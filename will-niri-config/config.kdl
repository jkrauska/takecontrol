	}

spawn-at-startup "noctalia"


    spawn-sh-at-startup "sleep 20 && opendeck"
    spawn-sh-at-startup "sleep 15 && slack"
    spawn-sh-at-startup "sleep 10 && discord"
    spawn-sh-at-startup "sleep 18 && app.bluebubbles.BlueBubbles"
    spawn-at-startup "xwayland-satellite"


